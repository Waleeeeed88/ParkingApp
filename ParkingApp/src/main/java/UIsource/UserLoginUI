    void createAndShowGUI() {
        frame = new JFrame("YorkU Parking Booking System"); // Initialize the frame
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setSize(600, 450);
        setLocationRelativeTo(null); //changes
        
