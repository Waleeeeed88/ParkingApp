// This is darkmode enhance the user experince
// this is the UI files for the user login
// To initalize darkmode Add this method to toggle dark mode
    private void toggleDarkMode() {
        isDarkMode = !isDarkMode;

        Color backgroundColor = isDarkMode ? Color.DARK_GRAY : Color.WHITE;
        Color textColor = isDarkMode ? Color.WHITE : Color.BLACK;
        
        mainPanel.setBackground(backgroundColor);
        frame.getContentPane().setBackground(backgroundColor);

        for (Component component : mainPanel.getComponents()) {
            if (component instanceof JPanel) {
                component.setBackground(backgroundColor);
                for (Component innerComponent : ((JPanel) component).getComponents()) {
                    if (innerComponent instanceof JLabel) {
                        innerComponent.setForeground(textColor);
                    } else if (innerComponent instanceof JTextField || innerComponent instanceof JPasswordField) {
                        innerComponent.setBackground(isDarkMode ? Color.GRAY : Color.WHITE);
                        innerComponent.setForeground(textColor);
                    } else if (innerComponent instanceof JButton) {
                        JButton button = (JButton) innerComponent;
                        // Ensure buttons **always** remain blue
                        button.setBackground(new Color(30, 144, 255)); // Dodger Blue
                        button.setForeground(Color.WHITE);
                    }
                }
            }
        }
    }

