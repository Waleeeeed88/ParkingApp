                 private JButton createActionButton(String text, Color bgColor) {
                     // Color-coded action buttons with hover effect
                     JButton button = new JButton(text);
                     button.setFont(new Font("Segoe UI", Font.BOLD, 14));
                     button.setForeground(Color.WHITE);
                     button.setBackground(bgColor);
                     button.setFocusPainted(false);
                     button.setBorderPainted(false);
                     button.setCursor(new Cursor(Cursor.HAND_CURSOR));
                     
                     button.addMouseListener(new MouseAdapter() {
                         @Override
                         public void mouseEntered(MouseEvent e) {
                             button.setBackground(bgColor.darker());
                         }
                         
                         @Override
                         public void mouseExited(MouseEvent e) {
                             button.setBackground(bgColor);
                         }
                     });
                     
                     return button;
                 }
                
               
                
             

                 // Enhanced method to show booking details with better formatting
                 private void showBookingDetails() {
                     String selectedLot = (String) lotSelector.getSelectedItem();
                     String selectedSpace = (String) spaceSelector.getSelectedItem();
                     
                     if (selectedLot != null && selectedSpace != null) {
                         String bookingId = findBookingId(selectedLot, selectedSpace);
                         if (bookingId != null) {
                             Booking booking = realTimeBookings.get(bookingId);
                             
                             // Format the booking details with better styling
                             StringBuilder details = new StringBuilder();
                             details.append(" Space: ").append(booking.getSpace()).append("\n\n");
                             details.append("Start Time: ").append(booking.getStartTime()).append("\n\n");
                             details.append("End Time: ").append(booking.getEndTime()).append("\n\n");
                             details.append("Vehicle Type: ").append(booking.getVehicleType()).append("\n\n");
                             details.append("Car Brand: ").append(booking.getCarBrand()).append("\n\n");
                             details.append("License Plate: ").append(booking.getLicensePlate()).append("\n\n");
                             details.append(" Duration: ").append(booking.getDuration()).append(" minutes\n");
                             
                             bookingDetailsArea.setText(details.toString());
                             
                             // Update the parking map to highlight this space (if implemented)
                             // updateParkingMapHighlight(selectedSpace);
                         } else {
                             bookingDetailsArea.setText("No booking found for " + selectedLot + " - " + selectedSpace);
                             // Clear any highlights on the parking map
                             // clearParkingMapHighlights();
                         }
                     } else {
                         bookingDetailsArea.setText("");
                     }
                 }
