                 private GridBagConstraints createGridBagConstraints() {
                     // Increased padding for better spacing
                     GridBagConstraints gbc = new GridBagConstraints();
                     gbc.insets = new Insets(8, 8, 8, 8); // More padding
                     gbc.fill = GridBagConstraints.HORIZONTAL;
                     return gbc;
                 }

                 private void addLabelAndComponent(JPanel panel, String labelText, JComponent component, GridBagConstraints gbc, int row) {
                     // Better styled labels with improved font and color
                     JLabel label = new JLabel(labelText);
                     label.setFont(new Font("Segoe UI", Font.BOLD, 14));
                     label.setForeground(new Color(44, 62, 80)); // Dark blue-gray text
                     
                     gbc.gridx = 0;
                     gbc.gridy = row;
                     gbc.weightx = 0.3;
                     gbc.anchor = GridBagConstraints.WEST;
                     panel.add(label, gbc);
                     
                     gbc.gridx = 1;
                     gbc.gridy = row;
                     gbc.weightx = 0.7;
                     panel.add(component, gbc);
                 }

         
                 
