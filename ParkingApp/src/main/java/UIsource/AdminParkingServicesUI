public AdminParkingServices(boolean isSuperManager) {
        this.isSuperManager = isSuperManager;
        parkingServices = new ParkingServices(); // Initialize ParkingServices instance
        parkingLots = new ArrayList<>();
        
        // --- UI Start ---
        frame = new JFrame("Parking Services");
        frame.setSize(500, 500);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLayout(new BorderLayout());
        
        // Create a header panel with title
        JPanel headerPanel = new JPanel();
        headerPanel.setBackground(new Color(0, 123, 255));
        headerPanel.setPreferredSize(new Dimension(500, 60));
        JLabel titleLabel = new JLabel("Parking Services");
        titleLabel.setFont(new Font("Arial", Font.BOLD, 24));
        titleLabel.setForeground(Color.WHITE);
        headerPanel.add(titleLabel);
        
        // Main content panel
        JPanel contentPanel = new JPanel();
        contentPanel.setLayout(new BoxLayout(contentPanel, BoxLayout.Y_AXIS));
        contentPanel.setBackground(new Color(240, 240, 240));
        
        // Panel for Parking Lots
        JPanel lotPanel = createLotPanel();
        contentPanel.add(lotPanel);
        
        // Panel for Parking Spaces
        JPanel spacePanel = createSpacePanel();
        contentPanel.add(spacePanel);
        
        // New Panel for Return Button
        JPanel returnPanel = new JPanel();
        returnPanel.setBackground(new Color(240, 240, 240));
        returnButton = new JButton("Return to Dashboard");
        returnButton.setBackground(new Color(0, 123, 255));
        returnButton.setForeground(Color.BLACK);
        returnButton.setFont(new Font("Arial", Font.BOLD, 14));
        returnPanel.add(returnButton);
        contentPanel.add(returnPanel);
        
        // Add panels to frame
        frame.add(headerPanel, BorderLayout.NORTH);
        frame.add(contentPanel, BorderLayout.CENTER);
        
        addEventHandlers();
        
        // Initialize real-time updates for lots
        loadParkingLotsRealtime();
        
        // When a lot is selected, load its parking spaces
        lotSelector.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                String selectedLotId = (String) lotSelector.getSelectedItem();
                if (selectedLotId != null) {
                    loadParkingSpacesRealtime(selectedLotId);
                    updateLotStatus(selectedLotId);
                }
            }
        });

        // When a space is selected, update the space status.
        spaceSelector.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                String selectedLotId = (String) lotSelector.getSelectedItem();
                String selectedSpaceId = (String) spaceSelector.getSelectedItem();
                if (selectedLotId != null && selectedSpaceId != null) {
                    updateSpaceStatus(selectedLotId, selectedSpaceId);
                }
            }
        });
        
        frame.setVisible(true);
    }
    
   
    
    private JPanel createLotPanel() {
        // Initialize the main panel for Parking Lot Management
        JPanel lotPanel = new JPanel();
        lotPanel.setLayout(new BorderLayout());
        
        // Create a titled border with blue color for the lot management section
        TitledBorder titledBorder = BorderFactory.createTitledBorder(
            BorderFactory.createLineBorder(new Color(30, 144, 255), 2),
            "Parking Lot Management"
        );
        titledBorder.setTitleFont(new Font("Arial", Font.BOLD, 16));
        titledBorder.setTitleColor(new Color(30, 144, 255));
        lotPanel.setBorder(titledBorder);
        
        // Main content panel with GridBagLayout
        JPanel contentPanel = new JPanel(new GridBagLayout());
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.fill = GridBagConstraints.HORIZONTAL;
        gbc.insets = new Insets(5, 5, 5, 5);
        
        // Create selector row
        JLabel lotSelectorLabel = new JLabel("Select Parking Lot");
        lotSelectorLabel.setFont(new Font("Arial", Font.PLAIN, 14));
        
        lotModel = new DefaultComboBoxModel<>();
        lotSelector = new JComboBox<>(lotModel);
        
        // Add selector components
        gbc.gridx = 0;
        gbc.gridy = 0;
        gbc.gridwidth = 1;
        gbc.weightx = 0.3;
        contentPanel.add(lotSelectorLabel, gbc);
        
        gbc.gridx = 1;
        gbc.gridy = 0;
        gbc.gridwidth = 1;
        gbc.weightx = 0.7;
        contentPanel.add(lotSelector, gbc);
        
        // Create button row
        JPanel buttonPanel = new JPanel(new GridLayout(1, 2, 10, 0));
        enableLotButton = new JButton("Enable Lot");
        disableLotButton = new JButton("Disable Lot");
        
        // Style buttons but keep them simple
        enableLotButton.setBackground(Color.LIGHT_GRAY);
        disableLotButton.setBackground(Color.LIGHT_GRAY);
        
        buttonPanel.add(enableLotButton);
        buttonPanel.add(disableLotButton);
        
        gbc.gridx = 0;
        gbc.gridy = 1;
        gbc.gridwidth = 2;
        gbc.weightx = 1.0;
        contentPanel.add(buttonPanel, gbc);
        
        // Create new lot row
        JLabel newLotLabel = new JLabel("New Lot Name");
        newLotLabel.setFont(new Font("Arial", Font.PLAIN, 14));
        
        lotNameField = new JTextField(15);
        
        gbc.gridx = 0;
        gbc.gridy = 2;
        gbc.gridwidth = 1;
        gbc.weightx = 0.3;
        contentPanel.add(newLotLabel, gbc);
        
        gbc.gridx = 1;
        gbc.gridy = 2;
        gbc.gridwidth = 1;
        gbc.weightx = 0.7;
        contentPanel.add(lotNameField, gbc);
        
        // Add New Lot button
        addLotButton = new JButton("Add New Lot");
        addLotButton.setBackground(Color.LIGHT_GRAY);
        
        gbc.gridx = 0;
        gbc.gridy = 3;
        gbc.gridwidth = 2;
        gbc.weightx = 1.0;
        contentPanel.add(addLotButton, gbc);
        
        // Status row
        JPanel statusPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
        JLabel lotStatusTextLabel = new JLabel("Lot Status:");
        lotStatusTextLabel.setFont(new Font("Arial", Font.PLAIN, 14));
        lotStatusLabel = new JLabel("Unknown");
        lotStatusLabel.setFont(new Font("Arial", Font.PLAIN, 14));
        
        statusPanel.add(lotStatusTextLabel);
        statusPanel.add(lotStatusLabel);
        
        gbc.gridx = 0;
        gbc.gridy = 4;
        gbc.gridwidth = 2;
        contentPanel.add(statusPanel, gbc);
        
        lotPanel.add(contentPanel, BorderLayout.CENTER);
        
        return lotPanel;
    }
    
